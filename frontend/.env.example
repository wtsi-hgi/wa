WA_RESULTS_BACKEND_URL=https://localhost:8090
WA_RESULTS_BACKEND_CA_CERT=
WA_MLWH_BACKEND_URL=
WA_STUDIES_CACHE_TTL_SECONDS=300

# Comma-separated LDAP usernames allowed to use the /feedback admin page. The
# OS user running Next.js is always allowed as well.
WA_FEEDBACK_ADMINS=

# Secured mode only: the --server-token basename or absolute path of a secured
# `wa mlwh serve`, set to the same value in both processes' environments. Leave
# unset in plain mode, where both use .wa-mlwh-server.token.
# WA_MLWH_SERVER_TOKEN=

# Extra hostnames the Next.js dev server should accept cross-origin requests
# from (comma separated). Merged with the defaults baked into next.config.ts:
# `localhost` and `127.0.0.1`. Only honoured when NODE_ENV != production.
WA_DEV_ALLOWED_ORIGINS=
